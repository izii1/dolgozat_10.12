<Window x:Class="dolgozat_10._12.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dolgozat_10._12"
        mc:Ignorable="d"
        Title="MainWindow" Height="930" Width="500">
    <Grid Margin="40px">
        <StackPanel>
            <TextBlock
                Text="Autókölcsönző"
                Margin="0,0,0,10"
                Height="40"
                Width="255"
                FontSize="30"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                />
            <TextBlock
                Text="Név:"
                Margin="0,0,0,0"
                Height="30"
                Width="150"
                FontSize="15"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                />
            <TextBox
                x:Name="txtName"
                Margin="0,0,0,10"
                Height="20"
                Width="150"
                HorizontalAlignment="Left"
                />
            <TextBlock
                Text="Életkor:"
                Margin="0,0,0,0"
                Height="30"
                Width="150"
                FontSize="15"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                />
            <TextBox
                x:Name="txtAge"
                Margin="0,0,0,10"
                Height="20"
                Width="150"
                HorizontalAlignment="Left"
                />

            <TextBlock
                Text="Jogosítvány szám:"
                Margin="0,0,0,0"
                Height="30"
                Width="150"
                FontSize="15"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                />
            <TextBox
                x:Name="txtJogsi"
                Margin="0,0,0,10"
                Height="20"
                Width="150"
                HorizontalAlignment="Left"
                />
            <TextBlock
                Text="Autó kiválasztása:"
                Margin="0,0,0,0"
                Height="30"
                Width="150"
                FontSize="15"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                />
            <ComboBox
                x:Name="myComboBox"
                Height="20"
                Width="200"
                Margin="0,0,0,10"
                HorizontalAlignment="Left"
                SelectedIndex="-1">
                <ComboBoxItem>Suzuki Swift – 12 000 Ft / nap</ComboBoxItem>
                <ComboBoxItem>Toyota Corolla – 18 000 Ft / nap</ComboBoxItem>
                <ComboBoxItem>BMW 3 – 30 000 Ft / nap</ComboBoxItem>
                <ComboBoxItem>Tesla Model 3 – 35 000 Ft / nap</ComboBoxItem>
            </ComboBox>

            <TextBlock
                Text="Bérlés időtartama:"
                Margin="0,0,0,0"
                Height="30"
                Width="150"
                FontSize="15"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                />
            <TextBox
                x:Name="txtBerlesIdo"
                Margin="0,0,0,10"
                Height="20"
                Width="150"
                HorizontalAlignment="Left"
                />
            
            <TextBlock
                Text="Biztosítás:"
                Margin="0,0,0,0"
                Height="30"
                Width="150"
                FontSize="15"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                />
            <RadioButton
                 x:Name="rbA"
                 GroupName="prov"
                 Margin="0,0,0,0"
                 Height="30"
                 Width="200"
                 Content="Alap biztosítás – ingyenes"
                 HorizontalAlignment="Left"/>
            <RadioButton
                 x:Name="rbEx"
                 GroupName="prov"
                 Margin="0,0,0,0"
                 Height="30"
                 Width="200"
                 Content="Extra biztosítás – +3000 Ft / nap"
                 HorizontalAlignment="Left"/>

            <RadioButton
                 x:Name="rbAll"
                 GroupName="prov"
                 Margin="0,0,0,0"
                 Height="30"
                 Width="200"
                 Content="Teljes biztosítás – +6000 Ft / nap"
                 HorizontalAlignment="Left"/>
            
            <TextBlock
                Text="Extra szolgáltatások:"
                Margin="0,0,0,0"
                Height="30"
                Width="150"
                FontSize="15"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                />

           <CheckBox
                x:Name="check1"
                Margin="0,0,0,0"
                Height="30"
                Width="300"
                Content="GPS – +1000 Ft / nap"
                HorizontalAlignment="Left"
            />
            <CheckBox
            x:Name="check2"
            Margin="0,0,0,0"
            Height="30"
            Width="300"
            Content="Gyerekülés – +1500 Ft / nap"
            HorizontalAlignment="Left"
            />
            <CheckBox
            x:Name="check3"
            Margin="0,0,0,0"
            Height="30"
            Width="300"
            Content="Extra sofőr – +2500 Ft / nap"
            HorizontalAlignment="Left"
            />
            <CheckBox
            x:Name="check4"
            Margin="0,0,0,0"
            Height="30"
            Width="300"
            Content="Autópálya matrica – +5000 Ft egyszeri díj"
            HorizontalAlignment="Left"
            />
            
            <TextBlock
                Text="Fizetési mód:"
                Margin="0,10,0,0"
                Height="30"
                Width="150"
                FontSize="15"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                />

            <RadioButton
                 x:Name="rbCash"
                 GroupName="pay"
                 Margin="0,0,0,0"
                 Height="30"
                 Width="150"
                 Content="Készpénz"
                 HorizontalAlignment="Left"/>
            <RadioButton
                 x:Name="rbCard"
                 GroupName="pay"
                 Margin="0,0,0,0"
                 Height="30"
                 Width="150"
                 Content="Bankkártya"
                 HorizontalAlignment="Left"/>
            
            <CheckBox
                x:Name="checkAll"
                Margin="0,20,0,0"
                Height="30"
                Width="300"
                Content="Elfogadom a bérlési feltételeket"
                HorizontalAlignment="Left"
                />

            <Button
                x:Name="btnAccept"
                Margin="0,10,0,0"
                Height="30"
                Width="200"
                FontWeight="Bold"
                FontSize="20"
                Content="Bérlés"
                HorizontalAlignment="Center" Click="btnAccept_Click"/>
        </StackPanel>
    </Grid>
</Window>
